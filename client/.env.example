# ---------------------------------------------------------------------------
# SplitEasy client - browser-visible environment.
# Copy to client/.env.local (ignored by Git) and match the port in server/.env.
# Vite only exposes variables prefixed with VITE_ to the browser.
#
# Never put MONGO_URI or any other secret in this file. The browser cannot
# keep a database credential secret.
# ---------------------------------------------------------------------------

# Base URL including the /api prefix. No trailing slash.
# Match PORT in server/.env. macOS AirPlay often uses 5000, so change both
# files to 5001 if the API cannot bind to 5000 on your machine.
VITE_API_BASE_URL=http://localhost:5000/api
