# ---------------------------------------------------------------------------
# SplitEasy API - environment variable template
# Copy this file to server/.env and replace every placeholder with real values.
# Never commit server/.env.
# ---------------------------------------------------------------------------

# HTTP server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
# Replace <username>, <password>, <cluster> and <database>.
# If the password contains special characters, URL-encode them
# (for example: @ becomes %40, # becomes %23).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/splitease?retryWrites=true&w=majority

# Browser origins allowed to call this API (comma-separated, no trailing slash).
CLIENT_ORIGIN=http://localhost:5173
